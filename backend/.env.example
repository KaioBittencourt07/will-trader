OPENAI_API_KEY=coloque_sua_chave_aqui
OPENAI_MODEL=gpt-6-luna
GROK_API_KEY=coloque_sua_chave_xai_aqui
GROK_MODEL=configure_um_modelo_disponivel_na_xai
CLAUDE_API_KEY=coloque_sua_chave_anthropic_aqui
CLAUDE_MODEL=configure_um_modelo_disponivel_na_anthropic
CLAUDE_API_VERSION=2023-06-01
TWELVEDATA_API_KEY=coloque_sua_chave_twelvedata_aqui
# Feed de ticks somente SHADOW/observabilidade; desativado por padrão.
WILL_TWELVE_WS_ENABLED=false
WILL_TWELVE_WS_SYMBOLS=EUR/USD
# Commissioning manual limitado (5-60s); não faz REST nem inicia batch.
WILL_TWELVE_WS_COMMISSION_MS=30000
MARKET_MAX_AGE_MS=10000
MARKET_CACHE_TTL_MS=10000
# Public exchange REST cache/rate protection; these are independent from billed Twelve Data credits.
MARKET_PUBLIC_CRYPTO_CACHE_TTL_MS=3000
MARKET_PUBLIC_CRYPTO_MIN_REQUEST_INTERVAL_MS=1000
# Configure these caps to the actual provider plan. Default runtime fallback: 6 credits/minute and 720 credits/rolling 24 hours.
# Basic plan example: four symbols across quote + time_series use about eight credits; headroom is reserved daily.
MARKET_CREDITS_PER_MINUTE=8
MARKET_CREDITS_PER_DAY=720
# Requests fail closed rather than staying open when the next daily quota slot is far away.
MARKET_MAX_DAILY_CREDIT_WAIT_MS=10000
MARKET_MIN_REQUEST_INTERVAL_MS=60000
MARKET_SCAN_MAX_SYMBOLS=4
# Catálogo operacional Avalon. Substitua pelos símbolos exatamente como aparecem
# na sua conta; o scanner nunca analisa um ativo fora desta lista.
AVALON_FOREX_ASSETS=EUR/USD,GBP/USD,USD/JPY,USD/BRL,EUR/GBP,AUD/USD,USD/CHF,NZD/USD
AVALON_CRYPTO_ASSETS=BTC/USD,ETH/USD,SOL/USD,ADA/USD,BNB/USD,XRP/USD,DOGE/USD,MATIC/USD
AVALON_STOCK_ASSETS=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META,AMD
DEFAULT_ASSET=EUR/USD
PORT=3000
# Token secreto longo; obrigatório em NODE_ENV=production. Não compartilhe no frontend público.
WILL_API_ACCESS_TOKEN=configure_um_token_secreto_longo
# Para relay em outro host, use um token exclusivo; nunca encaminhe o token geral da API.
# WILL_LOCAL_MARKET_RELAY_TOKEN=
DASHBOARD_ORIGIN=https://kaiobittencourt07.github.io
# A entrada manual só é considerada entre 1 e 5 minutos após o sinal.
ENTRY_DELAY_SECONDS=120
ENTRY_WINDOW_START_SECONDS=60
ENTRY_WINDOW_END_SECONDS=300
EXPIRY_SECONDS=60
# Identificador imutável da lógica que gerou cada sinal (não altera thresholds).
WILL_STRATEGY_VERSION=will-core-v1
ALLOW_DETERMINISTIC_FALLBACK=true
